# =============================================================================
# OpenTAKServer Docker environment template
# Copy to .env and edit before running `docker compose up -d`.
#   cp .env.example .env
# =============================================================================

# ---- PostgreSQL (REQUIRED) --------------------------------------------------
POSTGRES_DB=ots
POSTGRES_USER=ots
# Pick a strong password. Required: compose will refuse to start without it.
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ---- RabbitMQ (REQUIRED) ----------------------------------------------------
RABBITMQ_DEFAULT_USER=ots
# Pick a strong password. Required: compose will refuse to start without it.
RABBITMQ_DEFAULT_PASS=change-me-to-a-long-random-string

# ---- OpenTAKServer CA / identity -------------------------------------------
# Used to generate the self-signed CA that issues ATAK client certs.
OTS_CA_PASSWORD=atakatak
OTS_CA_ORGANIZATION=MyOrg
OTS_CA_CITY=MyCity
OTS_CA_STATE=MyState
OTS_CA_COUNTRY=US

# ---- OpenTAKServer secrets --------------------------------------------------
# Optional. If left blank, the entrypoint generates random values ONCE and
# persists them to /data/ots/config.yml. Rotating these later invalidates all
# existing sessions and password hashes. Back up /data before changing.
OTS_SECRET_KEY=
OTS_SECURITY_PASSWORD_SALT=

# ---- Ports ------------------------------------------------------------------
# Defaults shown. Override only if you need different host ports.
OTS_SSL_STREAMING_PORT=8089
OTS_CERTIFICATE_ENROLLMENT_PORT=8446
# OTS_MARTI_HTTPS_PORT=8443
# OTS_TCP_STREAMING_PORT=8088
